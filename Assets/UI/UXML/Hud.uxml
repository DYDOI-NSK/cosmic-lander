<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:cl="CosmicLander.UI" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/Theme.uss?fileID=7433441132597879392&amp;guid=29fd7a1e65797af638c2849572651e8d&amp;type=3#Theme"/>
    <Style src="project://database/Assets/UI/USS/Hud.uss?fileID=7433441132597879392&amp;guid=edfa453d8628dc274a1417146c6d0ab0&amp;type=3#Hud"/>
    <ui:VisualElement name="hud-root" picking-mode="Ignore" class="hud-root">
        <ui:VisualElement name="hud-left" picking-mode="Ignore" class="hud-left">
            <ui:VisualElement picking-mode="Ignore" class="hud-left__buttons">
                <cl:IconButton name="menu-button" class="icon-button--menu"/>
                <cl:IconButton name="restart-button" class="icon-button--restart"/>
            </ui:VisualElement>
            <cl:ScoreLabel name="score-label"/>
        </ui:VisualElement>

        <ui:VisualElement name="hud-right" picking-mode="Ignore" class="hud-right">
            <cl:FuelBar name="fuel-bar"/>
            <cl:SpeedGauge name="speed-gauge"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
